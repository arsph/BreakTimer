          }
        }
      }
    },
    "Deine Pause läuft seit %@ Uhr. Wann hast du sie tatsächlich beendet?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Pause läuft seit %@ Uhr. Wann hast du sie tatsächlich beendet?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your break has been running since %@. When did it actually end?"
          }
        }
      }
    },
    "Deine Pausen werden auf dem Gerät gespeichert und mit deinem Konto abgeglichen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Pausen werden auf dem Gerät gespeichert und mit deinem Konto abgeglichen."
