    "%lld Änderungen sind noch nicht synchronisiert und gehen beim Abmelden verloren. Alle Pausen und Einstellungen werden von diesem iPhone entfernt.": {
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Änderung ist noch nicht synchronisiert und geht beim Abmelden verloren. Alle Pausen und Einstellungen werden von diesem iPhone entfernt."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Änderungen sind noch nicht synchronisiert und gehen beim Abmelden verloren. Alle Pausen und Einstellungen werden von diesem iPhone entfernt."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld change hasn't been synced yet and will be lost when you sign out. All breaks and settings will be removed from this iPhone."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld changes haven't been synced yet and will be lost when you sign out. All breaks and settings will be removed from this iPhone."
                }
              }
            }
          }
        }
      }
    },
