    "Dein Konto, alle Pausen, Einstellungen und das Protokoll werden unwiderruflich gelöscht. Gib zur Bestätigung „%@“ ein.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto, alle Pausen, Einstellungen und das Protokoll werden unwiderruflich gelöscht. Gib zur Bestätigung „%@“ ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account, all breaks, settings and the log will be deleted permanently. Type “%@” to confirm."
          }
        }
      }
    },
    "Dein Passwort wurde geändert.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Passwort wurde geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your password has been changed."
          }
        }
