    "Alle Pausen und Einstellungen werden von diesem iPhone entfernt. Sie bleiben in deinem Konto gespeichert.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Pausen und Einstellungen werden von diesem iPhone entfernt. Sie bleiben in deinem Konto gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All breaks and settings will be removed from this iPhone. They stay saved in your account."
          }
        }
      }
    },
    "Anmelden": {
