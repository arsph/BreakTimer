    "Das Passwort ist zu schwach. Wähle ein längeres oder komplexeres Passwort.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Passwort ist zu schwach. Wähle ein längeres oder komplexeres Passwort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This password is too weak. Choose a longer or more complex one."
          }
        }
      }
    },
    "Das Protokoll enthält technische Daten und Pausenzeiten, aber keine Passwörter.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Protokoll enthält technische Daten und Pausenzeiten, aber keine Passwörter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The log contains technical data and break times, but no passwords."
          }
        }
      }
    },
    "Das Protokoll hilft dem Support bei der Fehlersuche. Es wird nur auf diesem iPhone gelöscht.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Protokoll hilft dem Support bei der Fehlersuche. Es wird nur auf diesem iPhone gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The log helps support find problems. It is only deleted on this iPhone."
          }
        }
      }
    },
    "Das Protokoll konnte nicht erstellt werden.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Protokoll konnte nicht erstellt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The log couldn't be created."
          }
        }
      }
    },
    "Das neue Passwort muss sich vom bisherigen unterscheiden.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das neue Passwort muss sich vom bisherigen unterscheiden."
